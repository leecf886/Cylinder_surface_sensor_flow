{
  "_comment": "Sanitized Scheme-A WP-A example protocol configuration (relative paths only, not for formal claims).",
  "schema_version": "wp-a-scheme-a-protocol-v1",
  "work_package": "wp_a",
  "approval_status": "pending",
  "example_not_formal": true,
  "data_root": "./data",
