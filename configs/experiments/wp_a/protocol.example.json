    "ppinn_checkpoint": "./runs/wp_a/ppinn_selection/best_ppinn.pt",
    "dynamic_checkpoint": "./runs/wp_b/shared_dynamic/best_model.pt",
    "pod_checkpoint": "./runs/wp_a/pod/pod_model.npz",
